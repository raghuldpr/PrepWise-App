# Copy to .dev.vars (gitignored) for local development with `wrangler dev`. Use your own random values.
JWT_SECRET=change-me-to-a-long-random-string
PASSWORD_PEPPER=change-me-to-another-long-random-string
# Allow the Vite dev server origin
ALLOWED_ORIGINS=http://localhost:5173

# Optional AI assistant (off unless AI_ENABLED is true). See docs/ITERATION-7.md.
# AI_ENABLED=true
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
